{
  "name": "streuphs-maze",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, configurable JavaScript puzzle game",
  "author": "Julien Fistre <julien.fistre@gmail.com> (https://github.com/Streuphy)",
  "homepage": "https://github.com/Streuphy",
  "scripts": {
    "test": "node tests/verify.js && node tests/browser-test.js",
    "test:rules": "node tests/verify.js",
    "test:browser": "node tests/browser-test.js",
    "test:unit:registry": "node tests/unit/registry.js",
    "test:unit:rules": "node tests/verify.js --suite=rules",
    "test:unit:levels": "node tests/verify.js --suite=levels",
    "test:unit:helpers": "node tests/verify.js --suite=helpers",
    "test:unit": "node tests/verify.js --suite=all-unit",
    "levels:emit": "node scripts/emit-levels-yaml.js",
    "levels:routes": "node scripts/report-par-routes.js"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
